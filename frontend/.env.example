# Copy this file to .env.local and adjust if your backend isn't on the default port.
# .env.local is gitignored — never commit real environment files.

# Base URL of the HFX Connect backend API. Not a secret (it's the same URL anyone
# using the site's network tab can already see) — NEXT_PUBLIC_ variables are inlined
# into the browser bundle at build time, so nothing sensitive may ever go in one. See
# frontend/README.md's "Environment Configuration" section for the full explanation
# and production expectations.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
