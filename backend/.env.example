# Copy this file to backend/.env and export it into your shell before running
# ./mvnw spring-boot:run if you need values different from the defaults baked
# into src/main/resources/application.properties (for example: a non-default
# port because something else is already using 5432, or different local
# credentials). Spring resolves these as real environment variables — this
# file does not get loaded automatically; see backend/README.md for how to
# export it.
#
# These values match docker-compose.yml's local development defaults, so
# `docker compose up -d` plus `./mvnw spring-boot:run` works out of the box
# with NO environment variables set at all. This file exists to document the
# variable names and to support overriding them, not because they are
# required for basic local development.
#
# Development-only values below. Never commit real credentials to this file
# or to backend/.env (which is gitignored).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hfx_connect
DB_USERNAME=hfx_connect
DB_PASSWORD=hfx_connect_dev_password
