# Copy this file to backend/.env and export it into your shell before running
# ./mvnw spring-boot:run. Spring resolves these as real environment variables —
# this file does not get loaded automatically; see backend/README.md for how
# to export it.
#
# DB_*/CORS_ALLOWED_ORIGINS below match docker-compose.yml's local development
# defaults and are all optional overrides — application.properties falls back
# to a working value for each of them if unset, so `docker compose up -d` plus
# `./mvnw spring-boot:run` works without exporting any of those specifically.
#
# JWT_SECRET is different and REQUIRED — see its own section below.
# application.properties has deliberately no fallback default for it, so the
# backend refuses to start at all unless it's set, in this file (exported) or
# any other environment.
#
# Development-only values below. Never commit real credentials to this file
# or to backend/.env (which is gitignored).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hfx_connect
DB_USERNAME=hfx_connect
DB_PASSWORD=hfx_connect_dev_password

# Comma-separated list of origins allowed to call /api/v1/** directly from a
# browser (see com.hfxconnect.common.config.WebCorsConfig). The default already
# matches the frontend's own local dev default (frontend/.env.example), so no
# override is needed for standard local development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Access-token signing (com.hfxconnect.auth.AccessTokenService — see ADR-008).
# REQUIRED — application.properties has no fallback default for this one
# (unlike DB_*/CORS_ALLOWED_ORIGINS above): a working default JWT signing
# secret baked into a public repository would let anyone who reads the source
# forge valid access tokens if a real deployment ever forgot to override it,
# which is a materially worse failure mode than a default database password.
# The backend will not start at all without JWT_SECRET set to something at
# least 32 bytes long.
#
# The value below is an OBVIOUSLY development-only placeholder — it must
# never be reused anywhere real. Generate a real secret for any non-local
# environment with, e.g.:
#   openssl rand -base64 48
# and set it as JWT_SECRET there. Never commit a real secret to this file or
# to backend/.env (gitignored).
JWT_SECRET=dev-only-insecure-placeholder-secret-change-me-before-any-real-deployment
JWT_ISSUER=hfx-connect
# Seconds. 900 = 15 minutes.
JWT_ACCESS_TOKEN_TTL=900
# Seconds. 2592000 = 30 days.
JWT_REFRESH_TOKEN_TTL=2592000

# Refresh-cookie policy (com.hfxconnect.auth.RefreshCookieConfig — see
# ADR-008). Defaults below are correct for local development only:
# localhost:3000 and localhost:8080 are different origins but the same site,
# so SameSite=Lax cookies still flow, and plain HTTP is normal locally, so
# Secure=false is required (browsers drop Secure cookies over plain HTTP).
#
# This project's actual production deployment (Vercel frontend, Render
# backend — see ADR-006) is genuinely cross-site, not just cross-origin —
# SameSite=Lax cookies are NOT sent on cross-site fetch/XHR at all, only on
# top-level navigation. Production MUST override both:
#   AUTH_COOKIE_SECURE=true
#   AUTH_COOKIE_SAME_SITE=None
# (SameSite=None without Secure=true is rejected by browsers outright, so
# these two must always change together.)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
